# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values to GitHub.

# AI keys, tried in this order: OpenAI → Gemini → Groq. Any you leave out are skipped.
# Keep them as GitHub repository secrets; the "Sync AI keys to Vercel" action copies them here.
OPENAI_API_KEY=sk-your_key_here
GEMINI_API_KEY=your_gemini_key_here
# GROQ_API_KEY=gsk_your_key_here

# From Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# Only this Google account can sign in (and spend your AI credit)
ALLOWED_EMAIL=avijeetgupta02@gmail.com

# Any long random string, 32+ characters. Changing it signs you out everywhere.
SESSION_SECRET=replace-with-a-long-random-string

# Your deployed address, no trailing slash
APP_URL=https://your-app.vercel.app

# Optional overrides
# OPENAI_TEXT_MODEL=gpt-6-luna
# OPENAI_VISION_MODEL=gpt-6-luna
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# AI_ORDER=openai,gemini,groq
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# GEMINI_VISION_MODEL=gemini-3.5-flash-lite
# GEMINI_STT_MODEL=gemini-3.5-flash-lite
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_STT_MODEL=whisper-large-v3-turbo
# DRIVE_FOLDER_NAME=CutTrack AI
